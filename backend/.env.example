# =====================================================================
# backend/.env.example
# Copy this file to backend/.env and fill in real values for local
# development. Never commit backend/.env to GitHub.
# =====================================================================

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_vehicle_accident_db?schema=public"

# ---------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------
# Accident Detection Thresholds (configurable, tune during testing)
# ---------------------------------------------------------------------
DECELERATION_THRESHOLD_G=4.5
ACCELERATION_SPIKE_THRESHOLD_G=6.0
GYRO_ABNORMAL_THRESHOLD_DPS=250
MIN_CONFIDENCE_TO_FLAG=0.55
ACCIDENT_COOLDOWN_SECONDS=120
SENSOR_BUFFER_WINDOW_SECONDS=10

# ---------------------------------------------------------------------
# Geo Lookup Service (Police / Hospital)
# ---------------------------------------------------------------------
GEO_LOOKUP_MODE=mock
GEO_SEARCH_RADIUS_KM=15
PLACES_API_KEY=

# ---------------------------------------------------------------------
# Notification Service
# ---------------------------------------------------------------------
NOTIFICATION_MODE=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@smart-vehicle-system.local

SMS_ENABLED=false
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

DEMO_POLICE_EMAIL=demo-police@example.com
DEMO_HOSPITAL_EMAIL=demo-hospital@example.com

# ---------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
