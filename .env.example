# =====================================================================
# ROOT .env.example
# This file documents ALL environment variables used across the
# Smart Vehicle Accident Detection and Emergency Response System.
#
# Actual runtime env files live in:
#   backend/.env
#   frontend/.env
#
# Copy the relevant sections into those files. NEVER commit real
# secrets to GitHub — only commit .env.example files.
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND — Server
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# BACKEND — Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_vehicle_accident_db?schema=public"

# ---------------------------------------------------------------------
# BACKEND — Authentication (JWT)
# ---------------------------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------
# BACKEND — Accident Detection Thresholds (configurable)
# ---------------------------------------------------------------------
DECELERATION_THRESHOLD_G=4.5
ACCELERATION_SPIKE_THRESHOLD_G=6.0
GYRO_ABNORMAL_THRESHOLD_DPS=250
MIN_CONFIDENCE_TO_FLAG=0.55
ACCIDENT_COOLDOWN_SECONDS=120
SENSOR_BUFFER_WINDOW_SECONDS=10

# ---------------------------------------------------------------------
# BACKEND — Geo Lookup Service (Police/Hospital)
# ---------------------------------------------------------------------
# "mock" uses seeded demo data. "live" would call a real Places API.
GEO_LOOKUP_MODE=mock
GEO_SEARCH_RADIUS_KM=15
# Only required if GEO_LOOKUP_MODE=live
PLACES_API_KEY=

# ---------------------------------------------------------------------
# BACKEND — Notification Service
# ---------------------------------------------------------------------
# "console" logs notifications to server console (safe default demo mode)
# "email" sends real emails via SMTP
NOTIFICATION_MODE=console

# SMTP (only required if NOTIFICATION_MODE=email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@smart-vehicle-system.local

# Optional SMS (Twilio-style) — only required if SMS is enabled
SMS_ENABLED=false
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Demo recipients (used when NOTIFICATION_MODE=email in demo mode)
DEMO_POLICE_EMAIL=demo-police@example.com
DEMO_HOSPITAL_EMAIL=demo-hospital@example.com

# ---------------------------------------------------------------------
# BACKEND — Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------
# FRONTEND — Vite (must be prefixed with VITE_)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13
