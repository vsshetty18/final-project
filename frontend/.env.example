# =====================================================================
# frontend/.env.example
# Copy this file to frontend/.env and adjust as needed.
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the
# browser bundle.
# =====================================================================

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Default map center (used when no accident/vehicle location is set)
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13
</parameter>
